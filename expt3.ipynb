   "source": [
    "from scipy import stats \n",
    "import numpy as np \n",
    "data = np.random.normal(50, 10, 100) \n",
    "print('Mean:', np.mean(data)) \n",
    "print('Median:', np.median(data)) \n",
    "print('Skewness:', stats.skew(data)) \n",
    "print('Kurtosis:', stats.kurtosis(data)) \n",
    "# One-sample t-test \n",
    "print(stats.ttest_1samp(data, 50))"
   ]
  }
 ],
