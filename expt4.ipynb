    "import pandas as pd \n",
    "import seaborn as sns \n",
    "import matplotlib.pyplot as plt \n",
    "# Sample census-like dataset \n",
    "census = pd.read_csv('census_sample.csv') \n",
    "numeric_census = census.select_dtypes(include='number')\n",
    "corr = numeric_census.corr() \n",
    "sns.heatmap(corr, annot=True) \n",
    "plt.show() "
   ]
  }
