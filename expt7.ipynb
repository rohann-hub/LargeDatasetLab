   "source": [
    "from scipy.stats import ttest_ind \n",
    "import numpy as np  \n",
    "data1 = np.random.normal(60, 5, 50) \n",
    "data2 = np.random.normal(55, 5, 50) \n",
    "result = ttest_ind(data1, data2) \n",
    "\n",
    "print(\"Statistic :\", result.statistic)\n",
    "print(\"P-value   :\", result.pvalue)\n",
    "print(\"DF        :\", result.df)"
   ]
  }
 ],
